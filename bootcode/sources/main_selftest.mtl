fun itoh2 x=
	let strcat "00" itoh x -> h in
	strsub h ((strlen h) - 2) 2;;

fun hexdata data i imax=
        if i<imax then (itoh2 strget data i)::hexdata data i+1 imax;;

fun getEncodedConf = strcatlist (hexdata conf 0 (strlen conf));;


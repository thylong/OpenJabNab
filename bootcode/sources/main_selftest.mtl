fun cutparam param =
	let strstr param " " 0 -> i in
		let if i==nil then param else strsub param 0 i -> addr in
		let if i==nil then "unknow" else strsub param i+1 strlen param -> caller in
		let strreplace caller " " "" -> caller in
		[addr caller];;


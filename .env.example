# OpenJabNab Environment Configuration
# Copy this file to .env and customize the values for your setup

# Domain Configuration
OJN_DOMAIN=nabaztag.yourdomain.com
OJN_HTTP_HOST=nabaztag.yourdomain.com
OJN_XMPP_HOST=nabaztag.yourdomain.com

# Port Configuration (usually don't need to change)
OJN_HTTP_PORT=8080
OJN_XMPP_PORT=5222

# Database Configuration (usually don't need to change for Docker)
DB_HOST=mysql
DB_NAME=ojn
DB_USER=ojn
DB_PASS=ojn
DB_PORT=3306

# Optional: Thunderforest API key for maps
THUNDERFOREST_APIKEY=

# Application Settings
OJN_ALLOW_REGISTRATION=true
OJN_DEBUG=true